{
    "version": 2,
    "builds": [
      {
        "src": "mkdocs.yml",
        "use": "@vercel/python",
        "config": {
          "installCommand": "pip3 install mkdocs",
          "buildCommand": "mkdocs build",
          "outputDirectory": "site"
        }
      },
      {
        "src": "site/**",
        "use": "@vercel/static"
      }
    ],
    "outputDirectory": "site"
  }